{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateRunRequest",
  "type": "object",
  "required": [
    "demonstration_mode",
    "include_dirty",
    "repository_path",
    "task_markdown"
  ],
  "properties": {
    "repository_path": {
      "type": "string"
    },
    "task_markdown": {
      "type": "string"
    },
    "candidate_count": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint8",
      "minimum": 0.0
    },
    "max_parallel_candidates": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint8",
      "minimum": 0.0
    },
    "max_repairs_per_candidate": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "commit_policy": {
      "anyOf": [
        {
          "$ref": "#/definitions/CommitPolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "quality_profile": {
      "anyOf": [
        {
          "$ref": "#/definitions/QualityProfile"
        },
        {
          "type": "null"
        }
      ]
    },
    "minimum_line_coverage": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "include_dirty": {
      "type": "boolean"
    },
    "agent_driver": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "demonstration_mode": {
      "type": "boolean"
    },
    "wall_clock_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "definitions": {
    "CommitPolicy": {
      "type": "string",
      "enum": [
        "manual",
        "automatic",
        "none"
      ]
    },
    "QualityProfile": {
      "type": "string",
      "enum": [
        "standard",
        "strict"
      ]
    }
  }
}
