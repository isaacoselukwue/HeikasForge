{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RunSummary",
  "type": "object",
  "required": [
    "candidate_progress",
    "commit_approved",
    "created_at",
    "current_nodes",
    "demonstration_mode",
    "elapsed",
    "plan_approved",
    "repository_path",
    "run_id",
    "status",
    "status_label",
    "task_title",
    "updated_at"
  ],
  "properties": {
    "run_id": {
      "$ref": "#/definitions/RunId"
    },
    "status": {
      "$ref": "#/definitions/RunStatus"
    },
    "status_label": {
      "type": "string"
    },
    "repository_path": {
      "type": "string"
    },
    "task_title": {
      "type": "string"
    },
    "created_at": {
      "$ref": "#/definitions/Timestamp"
    },
    "updated_at": {
      "$ref": "#/definitions/Timestamp"
    },
    "elapsed": {
      "$ref": "#/definitions/DurationMs"
    },
    "current_nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/NodeId"
      }
    },
    "candidate_progress": {
      "$ref": "#/definitions/CandidateProgress"
    },
    "winner": {
      "anyOf": [
        {
          "$ref": "#/definitions/CandidateId"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_event_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "demonstration_mode": {
      "type": "boolean"
    },
    "commit_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan_version": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "plan_approved": {
      "type": "boolean"
    },
    "commit_approved": {
      "type": "boolean"
    },
    "recovery_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "definitions": {
    "RunId": {
      "type": "string",
      "format": "uuid"
    },
    "RunStatus": {
      "type": "string",
      "enum": [
        "created",
        "validating",
        "planning",
        "awaiting_plan_approval",
        "running_candidates",
        "joining",
        "integrating",
        "awaiting_commit_approval",
        "succeeded",
        "exhausted",
        "failed",
        "cancelled",
        "recovery_required"
      ]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "DurationMs": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "NodeId": {
      "type": "string",
      "enum": [
        "prepare",
        "plan",
        "approval",
        "fan_out",
        "implement_candidate",
        "test_candidate",
        "review_candidate",
        "repair_candidate",
        "join",
        "integrate_winner",
        "final_test",
        "final_review",
        "commit_approval",
        "commit"
      ]
    },
    "CandidateProgress": {
      "type": "object",
      "required": [
        "active",
        "eligible",
        "ineligible",
        "pending",
        "total"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "eligible": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "ineligible": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "active": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "pending": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "CandidateId": {
      "type": "string"
    }
  }
}
